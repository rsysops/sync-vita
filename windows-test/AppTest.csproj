<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AppTest</AssemblyName>
    <OutputPath>bin\Release\net8.0-windows10.0.22621.0\</OutputPath>
    <DefineConstants>APPTEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\windows\MainForm.cs" Link="MainForm.cs" />
    <Compile Include="..\windows\Language.cs" Link="Language.cs" />
    <Compile Include="..\windows\LanguageForm.cs" Link="LanguageForm.cs" />
    <Compile Include="..\windows\Program.cs" Link="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="AForge.Video" Version="2.2.5" />
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
  </ItemGroup>
</Project>
